rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function myProfile() {
      return userDoc(request.auth.uid);
    }

    function myRole() {
      return myProfile().data.role;
    }

    function isAdmin() {
      return signedIn() && myRole() == "admin";
    }

    function isLeader() {
      return signedIn() && myRole() == "leader";
    }

    function isParent() {
      return signedIn() && myRole() == "parent";
    }

    function leaderMatchesGroupOrTeam(data) {
      return isLeader()
        && (
          data.group == myProfile().data.assignedGroup
          || data.team == myProfile().data.assignedTeam
        );
    }

    function parentLinkedToStudent(studentId) {
      return isParent() && studentId in myProfile().data.linkedStudentIds;
    }

    function parentEmailMatchesStudent(studentData) {
      return isParent() && studentData.parentEmail == request.auth.token.email;
    }

    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.role == "parent"
        && request.resource.data.linkedStudentIds == [];
      allow update, delete: if isAdmin();
    }

    match /students/{studentId} {
      allow read: if isAdmin()
        || leaderMatchesGroupOrTeam(resource.data)
        || parentLinkedToStudent(studentId)
        || parentEmailMatchesStudent(resource.data);
      allow create, update, delete: if isAdmin();
    }

    match /attendance/{attendanceId} {
      allow read: if isAdmin()
        || leaderMatchesGroupOrTeam(resource.data)
        || parentLinkedToStudent(resource.data.studentId)
        || parentEmailMatchesStudent(
          get(/databases/$(database)/documents/students/$(resource.data.studentId)).data
        );
      allow create, update: if isAdmin() || leaderMatchesGroupOrTeam(request.resource.data);
      allow delete: if isAdmin();
    }

    match /competitionPoints/{pointId} {
      allow read: if isAdmin()
        || leaderMatchesGroupOrTeam(resource.data)
        || parentLinkedToStudent(resource.data.studentId)
        || parentEmailMatchesStudent(
          get(/databases/$(database)/documents/students/$(resource.data.studentId)).data
        );
      allow create, update: if isAdmin() || leaderMatchesGroupOrTeam(request.resource.data);
      allow delete: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if signedIn();
      allow create, update: if isAdmin() || isLeader();
      allow delete: if isAdmin();
    }

    match /parentMessages/{messageId} {
      allow read: if isAdmin() || (isParent() && resource.data.parentId == request.auth.uid);
      allow create: if isParent()
        && request.resource.data.parentId == request.auth.uid
        && request.resource.data.parentEmail == request.auth.token.email
        && request.resource.data.status == "open";
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
